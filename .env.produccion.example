# En el servidor, copia este archivo como .env y genera cada clave con:
#   openssl rand -hex 32
# Usa solo letras y números: la contraseña de la base de datos va dentro de una URL.

# Dominio que apunta a la IP del servidor. Caddy obtiene el certificado https solo.
DOMINIO="censo.ejemplo.com"
POSTGRES_PASSWORD="CAMBIAR"
# Al menos 32 caracteres.
SESSION_PASSWORD="CAMBIAR"
# Contraseña inicial del usuario admin; cámbiala al entrar por primera vez.
ADMIN_PASSWORD="CAMBIAR"
