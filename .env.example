DATABASE_URL="postgresql://postgres:CONTRASENA@localhost:5432/censo?schema=public"
# Clave de al menos 32 caracteres para cifrar la cookie de sesión.
SESSION_PASSWORD="CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA"
# Usar "false" solo si el sistema se sirve por http, sin https.
COOKIE_SEGURA="true"
# Ruta de pg_dump para los respaldos, solo si no está en el PATH.
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/16/bin/pg_dump.exe"
# Contraseña inicial del usuario admin, usada por: npx prisma db seed
ADMIN_PASSWORD="CAMBIAR"
