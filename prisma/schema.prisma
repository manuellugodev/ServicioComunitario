// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  VOCERO
  CONSULTA

  @@map("rol")
}

model Usuario {
  id             Int        @id @default(autoincrement())
  nombreCompleto String     @map("nombre_completo") @db.VarChar(120)
  cedula         String     @unique @db.VarChar(12)
  usuario        String     @unique @db.VarChar(40)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  rol            Rol
  activo         Boolean    @default(true)
  creadoEn       DateTime   @default(now()) @map("creado_en")
  bitacora       Bitacora[]
  viviendas      Vivienda[]
  nucleos        NucleoFamiliar[]
  habitantes     Habitante[]

  @@map("usuario")
}

model Bitacora {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  accion     String   @db.VarChar(20)
  tabla      String   @db.VarChar(40)
  registroId Int      @map("registro_id")
  detalle    Json?
  fecha      DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("bitacora")
}

model TipoVivienda {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(80)
  viviendas Vivienda[]

  @@map("tipo_vivienda")
}

model Sector {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique @db.VarChar(80)
  viviendas Vivienda[]

  @@map("sector")
}

enum Tenencia {
  PROPIA
  ALQUILADA
  PRESTADA
  INVADIDA
  OTRA

  @@map("tenencia")
}

model Vivienda {
  id             Int          @id @default(autoincrement())
  codigo         String       @unique @db.VarChar(15)
  sectorId       Int          @map("sector_id")
  direccion      String       @db.VarChar(200)
  tipoViviendaId Int          @map("tipo_vivienda_id")
  tenencia       Tenencia?
  agua           Boolean      @default(false)
  electricidad   Boolean      @default(false)
  gas            Boolean      @default(false)
  aseo           Boolean      @default(false)
  internet       Boolean      @default(false)
  observaciones  String?
  creadoEn       DateTime     @default(now()) @map("creado_en")
  actualizadoEn  DateTime     @updatedAt @map("actualizado_en")
  creadoPorId    Int          @map("creado_por")
  sector         Sector       @relation(fields: [sectorId], references: [id])
  tipoVivienda   TipoVivienda @relation(fields: [tipoViviendaId], references: [id])
  creadoPor      Usuario      @relation(fields: [creadoPorId], references: [id])
  nucleos        NucleoFamiliar[]

  @@index([sectorId])
  @@map("vivienda")
}

model NucleoFamiliar {
  id              Int      @id @default(autoincrement())
  viviendaId      Int      @map("vivienda_id")
  ingresoAproxUsd Decimal? @map("ingreso_aprox_usd") @db.Decimal(10, 2)
  recibeClap      Boolean  @default(false) @map("recibe_clap")
  observaciones   String?
  creadoEn        DateTime @default(now()) @map("creado_en")
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")
  creadoPorId     Int      @map("creado_por")
  vivienda        Vivienda @relation(fields: [viviendaId], references: [id])
  creadoPor       Usuario  @relation(fields: [creadoPorId], references: [id])
  habitantes      Habitante[]

  @@index([viviendaId])
  @@map("nucleo_familiar")
}

enum Sexo {
  F
  M

  @@map("sexo")
}

enum Parentesco {
  JEFE
  CONYUGE
  HIJO
  PADRE_MADRE
  HERMANO
  NIETO
  OTRO

  @@map("parentesco")
}

enum NivelEducativo {
  SIN_ESCOLARIDAD
  PRIMARIA
  BACHILLERATO
  TSU
  UNIVERSITARIO
  POSTGRADO

  @@map("nivel_educativo")
}

enum EstadoHabitante {
  ACTIVO
  MUDADO
  FALLECIDO

  @@map("estado_habitante")
}

model Habitante {
  id                 Int             @id @default(autoincrement())
  nucleoId           Int             @map("nucleo_id")
  nacionalidad       String          @db.Char(1)
  cedula             String?         @db.VarChar(12)
  nombres            String          @db.VarChar(80)
  apellidos          String          @db.VarChar(80)
  fechaNacimiento    DateTime        @map("fecha_nacimiento") @db.Date
  sexo               Sexo
  parentesco         Parentesco
  telefono           String?         @db.VarChar(20)
  correo             String?         @db.VarChar(120)
  nivelEducativo     NivelEducativo? @map("nivel_educativo")
  estudiaActualmente Boolean         @default(false) @map("estudia_actualmente")
  ocupacion          String?         @db.VarChar(80)
  discapacidad       String?         @db.VarChar(80)
  enfermedadCronica  String?         @map("enfermedad_cronica") @db.VarChar(80)
  estado             EstadoHabitante @default(ACTIVO)
  creadoEn           DateTime        @default(now()) @map("creado_en")
  actualizadoEn      DateTime        @updatedAt @map("actualizado_en")
  creadoPorId        Int             @map("creado_por")
  nucleo             NucleoFamiliar  @relation(fields: [nucleoId], references: [id])
  creadoPor          Usuario         @relation(fields: [creadoPorId], references: [id])
  talentos           HabitanteTalento[]

  @@unique([nacionalidad, cedula])
  @@index([nucleoId])
  @@map("habitante")
}

model CategoriaTalento {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(80)
  talentos Talento[]

  @@map("categoria_talento")
}

model Talento {
  id          Int                @id @default(autoincrement())
  categoriaId Int                @map("categoria_id")
  nombre      String             @unique @db.VarChar(80)
  categoria   CategoriaTalento   @relation(fields: [categoriaId], references: [id])
  habitantes  HabitanteTalento[]

  @@index([categoriaId])
  @@map("talento")
}

enum NivelTalento {
  BASICO
  INTERMEDIO
  AVANZADO

  @@map("nivel_talento")
}

model HabitanteTalento {
  habitanteId      Int          @map("habitante_id")
  talentoId        Int          @map("talento_id")
  nivel            NivelTalento
  aniosExperiencia Int          @default(0) @map("anios_experiencia") @db.SmallInt
  certificado      Boolean      @default(false)
  disponible       Boolean      @default(true)
  habitante        Habitante    @relation(fields: [habitanteId], references: [id])
  talento          Talento      @relation(fields: [talentoId], references: [id])

  @@id([habitanteId, talentoId])
  @@index([talentoId])
  @@map("habitante_talento")
}

model Configuracion {
  id            Int    @id @default(1)
  nombreConsejo String @map("nombre_consejo") @db.VarChar(120)

  @@map("configuracion")
}
